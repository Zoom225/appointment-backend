# Documentation template. Spring Boot does not automatically load .env files.
# In dev, leave optional variables UNSET, not exported as empty strings.
SPRING_PROFILES_ACTIVE=dev
PORT=8081

# Production / Render: SPRING_PROFILES_ACTIVE=prod and all three values required.
# URL format: jdbc:postgresql://<host>:5432/<database>?sslmode=require
# Do not embed credentials in the URL or commit real credentials here.
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Production: set ONE frontend variable to the exact HTTPS origin (no trailing slash).
# APP_FRONTEND_URL takes precedence; leave the unused variable unset.
FRONTEND_URL=
APP_FRONTEND_URL=
# Optional additional exact origins, comma-separated. No wildcards.
# Without any configured origin, production denies cross-origin browser requests.
CORS_ALLOWED_ORIGINS=

# Production: random secret of at least 32 bytes, encoded in Base64, required.
# Development uses a public local-only key when JWT_SECRET is unset.
JWT_SECRET=
JWT_EXPIRATION=PT2H

APP_DEMO_ENABLED=false
# Required only if enabling the two public portfolio demo accounts in production.
APP_DEMO_USER_EMAIL=demo.user@appointment.local
APP_DEMO_USER_PASSWORD=
APP_DEMO_ADMIN_EMAIL=demo.admin@appointment.local
APP_DEMO_ADMIN_PASSWORD=
